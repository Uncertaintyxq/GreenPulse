{
    // Terminal > Run Task... offers these. They use Maven, the same build NetBeans uses.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GreenPulse: run with Maven",
            "type": "shell",
            "command": "mvn -q compile exec:exec",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "GreenPulse: run tests",
            "type": "shell",
            "command": "mvn test",
            "group": "test",
            "problemMatcher": []
        }
    ]
}
